# ── Vivado project trees (whole project dirs, not just run dirs) ───────────────
# Reference design build tree — only .xpr + empty stubs tracked, not full project
ip/vivado/xc7k480t.reference/xc7k480t_ref/
# NPU diagnostic project (xdma-minimal variant)
ip/vivado/xc7k480t/diag/npu_fpga_xdma_min/
# Migrate step project trees (build outputs only; TCL sources tracked)
ip/vivado/xc7k480t/proj_v*/
proj/

# NPU migrate bootstrapped project (regenerated by bootstrap_project.tcl)
ip/vivado/xc7k480t/proj/

# xcvu9p (Alivu9p) NPU project tree (regenerated from the reference IP + scripts)
ip/vivado/xcvu9p/prj/

# xcvu9p reference IP: keep descriptors (xci/bd/bda/xml/xdc/prj) + hand sources,
# ignore the generated RTL/netlists/sim/sysc that Vivado regenerates.
ip/vivado/xcvu9p/ip/**/sim/
ip/vivado/xcvu9p/ip/**/synth/
ip/vivado/xcvu9p/ip/**/sysc/
ip/vivado/xcvu9p/ip/**/hdl/
