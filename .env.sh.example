# ── FPGA bring-up environment ────────────────────────────────────────────────
# Source this file to set up paths for local development.
#
# Usage:
#   source .env.sh
#   make build                    # Chisel → top.sv (in Docker)
#   make build-fpga               # top.sv → bitstream (Vivado)
#   python3 tool/hw/bringup_ssh.py --host "$FPGA_HOST" <bitstream>

# Vivado installation (local dev host)
export VIVADO="<YOUR_VIVADO_PATH"
export VIVADO_JOBS="${VIVADO_JOBS:-4}"
export HW_SERVER="${HW_SERVER:-localhost:3121}"

# FPGA server (SSH target)
export FPGA_HOST="<YOUR_FPGA_SERVER_SSH_IP>"
export SSH_IDENTITY="<PATH_TO_YOUR_SSH_IDENTITY_TO_ACCESS_THE_FPGA>"

# Chisel Docker image
export CHISEL_IMAGE="${CHISEL_IMAGE:-fangruil/chisel-dev:amd64}"

# Bitstream paths
export BITSTREAM_DIR="${BITSTREAM_DIR:-$PWD/ip/vivado/xc7k480t}"
export BITSTREAM="${BITSTREAM:-$BITSTREAM_DIR/top_npu.bit}"

# XDMA driver (remote FPGA host)
export XDMA_DRV_DIR="${XDMA_DRV_DIR:-~/dma_ip_drivers/XDMA/linux-kernel/xdma}"

# Print summary
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
    echo "[env] VIVADO=$VIVADO"
    echo "[env] VIVADO_JOBS=$VIVADO_JOBS"
    echo "[env] FPGA_HOST=$FPGA_HOST"
    echo "[env] SSH_IDENTITY=$SSH_IDENTITY"
    echo "[env] BITSTREAM=$BITSTREAM"
fi
